# Backend Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit the real .env file to GitHub

# ─── Server ───────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Supabase (PostgreSQL) ────────────────────────────────────────────
# Get these from https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Authentication ───────────────────────────────────────────────────
# Get from https://console.cloud.google.com → OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string used to sign JWT tokens – generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── Code Execution (Judge0) ──────────────────────────────────────────
# https://judge0.com or self-hosted
JUDGE0_API_URL=
JUDGE0_API_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=
